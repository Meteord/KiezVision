# Copy to .env and fill in values. Never commit .env to git.

GEMINI_API_KEY=
MAPILLARY_ACCESS_TOKEN=
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Public, non-secret JSON model configuration. Vite exposes this to the browser.
VITE_OPENAI_IMAGE_MODELS=[{"id":"gpt-image-1.5","label":"GPT Image 1.5","operations":["generation","edit"]},{"id":"FLUX-1.1-pro","label":"FLUX 1.1 Pro","operations":["generation"]},{"id":"FLUX.1-Kontext-pro-edit","label":"FLUX.1 Kontext Pro","operations":["edit","mask-edit"]},{"id":"FLUX.2-pro","label":"FLUX.2 Pro","operations":["generation","edit"]},{"id":"FLUX.2-pro-edit","label":"FLUX.2 Pro Edit","operations":["edit","mask-edit"]}]
# Local development only. Set to true only for a LiteLLM endpoint with an untrusted certificate.
LITELLM_INSECURE_SKIP_TLS_VERIFY=false

ENABLE_SITE_PASSWORD=false
SITE_PASSWORD=
